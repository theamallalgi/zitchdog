#!/usr/bin/env bash

set -e

echo "Checking formatting..."
if ! stylua --check lua/; then
	echo "Formatting issues found, auto-fixing..."
	stylua lua/
	echo ""
	echo "Files were reformatted. Review the changes, then commit and push again."
	git diff --stat lua/
	exit 1
fi

echo "Running verify-noop..."
./scripts/verify-noop.sh

echo "All checks passed, pushing."
